# Payload and local Postgres
DATABASE_URL=postgres://mvp_realty_db:mvp_realty_db@localhost:5435/mvp_realty_db
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3002
DB_PUSH=false

# Server-only observability
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=

# Bridge Data Output (MLS) — server token + dataset id (e.g. nabor)
BRIDGE_API_TOKEN=
BRIDGE_DATASET_ID=
BRIDGE_SYNC_CRON=0 3 * * *
BRIDGE_SYNC_SECRET=

# Cloudflare R2 via S3-compatible API (@payloadcms/storage-s3)
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (host only — do NOT append /bucket)
# Public URL: custom domain or https://pub-….r2.dev (bucket-level public access; not object ACLs)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_URL=

# Lead capture — shared secret the web app presents to POST /api/leads/submit.
# Must match apps/web LEADS_INGEST_SECRET. Minimum 16 characters.
LEADS_INGEST_SECRET=

# On-demand cache invalidation. Origin of the Next.js app plus the bearer secret
# its /api/revalidate route checks; the secret must match apps/web
# CMS_REVALIDATE_SECRET. Leave either blank to disable — content edits then wait
# out the web app's time-based revalidation instead of failing the save.
WEB_APP_URL=http://localhost:3003
CMS_REVALIDATE_SECRET=

# Outbound SMTP — admin password resets and Wise Agent lead delivery.
# SMTP (not a provider SDK) so switching providers is an env change only.
# Resend: host smtp.resend.com, port 465, user "resend", password = API key.
# From address must be on a domain verified with the provider.
# Leave blank locally: Payload logs emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to true on port 465, false on 587/25.
SMTP_SECURE=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MVP Realty

# Wise Agent CRM lead-capture address (Integrations -> Settings -> API Keys and
# Lead Email). Their webconnect API is OAuth-only, so leads are delivered as
# parseable email. Leave blank locally: leads then save with crm.status
# 'skipped' and `pnpm -C apps/backend leads:resync` replays them once set.
WISE_AGENT_LEAD_EMAIL=
