{
  "name": "@mvp-realty/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3002",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --port 3002",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port ${PORT:-3002}",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .next .turbo .payload *.tsbuildinfo",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_ENV=production PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:fresh": "cross-env NODE_ENV=production PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "migrate:status": "cross-env NODE_ENV=production PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed:local": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/homepage/run-seed-local.ts",
    "seed:community": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/communities/run-seed.ts",
    "seed:privacy-policy": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/legal/run-seed-privacy-policy.ts",
    "media:remirror-homepage": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/shared/run-remirror-media.ts homepage",
    "media:remirror-communities": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/shared/run-remirror-media.ts communities",
    "media:remirror-listing-heroes": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/run-remirror-listing-heroes.ts",
    "bridge:sync": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/run-bridge-sync.ts",
    "leads:resync": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/leads/run-resync.ts",
    "audit:cms-blocks": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/audit-cms-blocks.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@mvp-realty/api-contracts": "workspace:*",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/email-nodemailer": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@t3-oss/env-core": "^0.11.1",
    "cross-env": "^10.0.0",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "nodemailer": "^9.0.3",
    "payload": "3.84.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mvp-realty/eslint-config": "workspace:*",
    "@mvp-realty/prettier-config": "workspace:*",
    "@mvp-realty/typescript-config": "workspace:*",
    "@mvp-realty/vitest-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "16.2.6",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "prettier": "@mvp-realty/prettier-config"
}
