# Public web origins
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
# Same origin as backend S3_PUBLIC_URL when Media is served from R2/S3
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only observability
SENTRY_AUTH_TOKEN=
AXIOM_TOKEN=
AXIOM_DATASET=

# Lead capture — must match apps/backend LEADS_INGEST_SECRET. Minimum 16 characters.
# Server-only; never exposed to the browser.
LEADS_INGEST_SECRET=

# Bearer secret Payload presents to POST /api/revalidate so CMS edits invalidate
# the cache immediately. Must match apps/backend CMS_REVALIDATE_SECRET.
CMS_REVALIDATE_SECRET=
