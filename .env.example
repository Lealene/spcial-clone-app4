# =============================================================================
# Combined environment reference
# For local setup, copy each workspace's own .env.example to .env.local.
# Production values live in the deployment provider.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared local infra (docker-compose.yml)
# -----------------------------------------------------------------------------
# Local docker-compose exposes Postgres on 5435 to avoid clashing with a system
# Postgres on 5432. Production uses the provider endpoint.
DATABASE_URL=postgres://mvp_realty_db:mvp_realty_db@localhost:5435/mvp_realty_db

# -----------------------------------------------------------------------------
# apps/web — @mvp-realty/web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_SENTRY_DSN=

# Server-only
SENTRY_AUTH_TOKEN=
AXIOM_TOKEN=
AXIOM_DATASET=

# -----------------------------------------------------------------------------
# apps/backend — @mvp-realty/backend (Payload v3)
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3002
DB_PUSH=false
# Reuses DATABASE_URL above.
SENTRY_DSN=
# AXIOM_TOKEN / AXIOM_DATASET reuse above.

# -----------------------------------------------------------------------------
# Turborepo Remote Cache (set after `pnpm exec turbo login && pnpm exec turbo link`)
# -----------------------------------------------------------------------------
TURBO_TOKEN=
TURBO_TEAM=
